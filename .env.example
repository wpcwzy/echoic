# ============================================================================
# Echoic 环境变量示例（复制为 .env 后按需修改）
#
#   cp .env.example .env
#   # 至少修改 ECHOIC_ADMIN_PASSWORD（默认弱口令）与 ECHOIC_SECRET_KEY 留空自动生成
#   docker compose pull && docker compose up -d      # 镜像优先（默认，无需本地构建）
#   # 从源码构建改为：docker compose -f docker-compose.yml -f docker-compose.build.yml up -d --build
#
# 约定：
#  - 所有配置都有合理默认值，不设置即使用默认值；
#  - ECHOIC_* 只用于「首次启动时写入数据库 app_settings」的 AI 配置初始值：
#    之后在「设置」页面修改的内容优先，重启不会被 .env 覆盖；
#  - docker compose 会自动读取本目录 .env（用于端口/PostgreSQL 变量插值，
#    并通过 env_file 注入容器）；
#  - 本机开发（scripts/dev.sh、scripts/run-local.sh）由后端自动读取仓库根目录 .env；
#  - .env 已在 .gitignore 中，切勿提交真实密钥。
# ============================================================================

# ------------------------------- 基础 -------------------------------
ECHOIC_APP_NAME=Echoic
# 调试模式：开启后暴露 /api/docs 与 /api/openapi.json（生产建议 false）
ECHOIC_DEBUG=false
ECHOIC_LOG_LEVEL=INFO

# 数据目录：SQLite、媒体文件、secret.key 都存放在这里。
# 本机开发默认 ./data；Docker 镜像内固定 /data（compose 已覆盖），
# 因此这里保持注释即可，避免本机运行时误写容器路径。
# ECHOIC_DATA_DIR=./data

# 数据库：留空 = SQLite（<data_dir>/echoic.db，默认，零依赖）。
# 若使用 PostgreSQL（docker compose --profile postgres），改为：
# ECHOIC_DATABASE_URL=postgresql+psycopg://echoic:<POSTGRES_PASSWORD>@postgres:5432/echoic

# ------------------------------- 安全（务必修改）------------------------------
# JWT 签名 + API Key 加密密钥。推荐留空：首次启动自动生成到 <data_dir>/secret.key。
# 如需显式指定，随机生成示例：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
ECHOIC_SECRET_KEY=

# 管理员账号：仅首次启动（数据库为空）时创建，之后请到「设置 → 账户」修改密码。
ECHOIC_ADMIN_USERNAME=admin
# ⚠️ 默认弱口令，公网/生产部署前必须修改！
ECHOIC_ADMIN_PASSWORD=admin123
ECHOIC_ADMIN_DISPLAY_NAME=管理员
# 登录有效期（天）
ECHOIC_SESSION_DAYS=7

# ------------------------------- 运行时 -------------------------------
# 是否在 API 进程内启动后台任务线程。使用独立 worker（--profile worker）时设为 false。
ECHOIC_EMBEDDED_WORKER=true
# 空库时自动写入内置演示录音（mock 模式零配置体验；生产可设为 false）
ECHOIC_DEMO_SEED=true
# 单文件上传上限（MB），默认 2GB
ECHOIC_MAX_UPLOAD_MB=2048
# 允许跨域的前端地址（逗号分隔；同源生产部署可留默认，仅开发跨端口需要）
ECHOIC_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# ffmpeg/ffprobe 可执行文件路径（默认取 PATH）
ECHOIC_FFMPEG=ffmpeg
ECHOIC_FFPROBE=ffprobe
# 使用 --profile postgres（或任何外部数据库）时设为 true：
# 容器入口脚本会等待 DATABASE_URL 指向的数据库端口就绪后再启动服务，避免启动竞态。
ECHOIC_WAIT_FOR_DB=false
# 前端静态资源目录：留空 = 自动探测 backend/app/static，再退回 frontend/dist。
# Docker 镜像固定 /app/backend/app/static（compose 已设置），本机一般无需配置。
# ECHOIC_STATIC_DIR=

# ------------------------------- 多用户 / 分享 / consume 导入（v0.2.0）------------------------------
# 是否开放网页注册（默认 false：仅管理员可在「用户管理」创建账号；开放注册需自担风险）
ECHOIC_ALLOW_REGISTRATION=false
# 公开分享链接解锁 Cookie 有效期（小时）
ECHOIC_SHARE_COOKIE_HOURS=2

# 「监听目录自动导入」：把音频/视频文件放入 consume 目录，服务会自动创建录音并处理。
ECHOIC_CONSUME_ENABLED=true
# consume 目录：留空 = <data_dir>/consume（Docker 内即 /data/consume，已随 echoic-data 卷持久化，
# 无需额外挂载；若要指向宿主机目录，可自行添加 bind mount 并在这里配置容器内路径）。
# ECHOIC_CONSUME_DIR=
# 扫描间隔（秒）
ECHOIC_CONSUME_INTERVAL_SEC=15
# 导入录音的归属用户（空 = 首个管理员）
ECHOIC_CONSUME_OWNER_USERNAME=

# ------------------------------- AI 服务 -------------------------------
# 默认全部 mock：无需任何 API Key，即可完整演示 UI 与处理管线（录制/上传→转写→纪要→问答）。
# 接入真实模型有两种方式（推荐后者）：
#   1) 在下面填写环境变量，首次启动写入数据库；
#   2) 启动后在「设置 → AI 服务」页面填写并「测试连接」，即时生效。

# ---- ASR（语音转文字）----
# 可选：mock | dashscope_realtime | dashscope_file | openai
ECHOIC_ASR_PROVIDER=mock
ECHOIC_ASR_API_KEY=
ECHOIC_ASR_BASE_URL=
ECHOIC_ASR_MODEL=
ECHOIC_ASR_LANGUAGE=zh
ECHOIC_ASR_DIARIZATION=true

# ---- LLM（纪要/观点树/问答）----
# 可选：mock | openai（openai = 任何 OpenAI 兼容端点：百炼/DashScope、DeepSeek、Ollama、vLLM…）
ECHOIC_LLM_PROVIDER=mock
ECHOIC_LLM_API_KEY=
ECHOIC_LLM_BASE_URL=
ECHOIC_LLM_MODEL=
ECHOIC_LLM_TEMPERATURE=0.3

# ---- Embedding（RAG 向量，可选；none = 使用字面/关键词检索）----
# 可选：none | openai | dashscope
ECHOIC_EMBEDDINGS_PROVIDER=none
ECHOIC_EMBEDDINGS_API_KEY=
ECHOIC_EMBEDDINGS_BASE_URL=
ECHOIC_EMBEDDINGS_MODEL=
ECHOIC_EMBEDDINGS_DIMENSIONS=1024

# ------------------------------- 阿里云百炼 DashScope 配置示例 -------------------------------
# 在 https://bailian.console.aliyun.com/ 创建 API Key，并开通 Paraformer 语音识别与 Qwen 模型。
# 取消下面注释、填入同一个 API Key 即可（ASR 走实时 WebSocket，LLM 走 OpenAI 兼容端点）：
#ECHOIC_ASR_PROVIDER=dashscope_realtime
#ECHOIC_ASR_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
#ECHOIC_ASR_BASE_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
#ECHOIC_ASR_MODEL=paraformer-realtime-v2
#ECHOIC_ASR_LANGUAGE=zh
#ECHOIC_ASR_DIARIZATION=true
#ECHOIC_LLM_PROVIDER=openai
#ECHOIC_LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
#ECHOIC_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#ECHOIC_LLM_MODEL=qwen-plus
#ECHOIC_LLM_TEMPERATURE=0.3
# 可选：用百炼 Embedding 提升 RAG 检索质量（与上面同一个 Key）
#ECHOIC_EMBEDDINGS_PROVIDER=dashscope
#ECHOIC_EMBEDDINGS_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
#ECHOIC_EMBEDDINGS_BASE_URL=https://dashscope.aliyuncs.com
#ECHOIC_EMBEDDINGS_MODEL=text-embedding-v3
#ECHOIC_EMBEDDINGS_DIMENSIONS=1024

# ------------------------------- 容器镜像（v0.2+，镜像优先部署）------------------------------
# 默认部署方式不本地构建，直接拉取 GHCR 预构建多架构镜像（linux/amd64 + linux/arm64）：
#   docker compose pull && docker compose up -d
#
# 镜像标签选择：
#   latest    main 分支最新构建（默认，适合体验/跟进最新功能）
#   v0.2.0    语义化版本（生产建议固定版本，避免意外升级；也支持 0.2）
#   sha-abc123 某次提交构建（可复现 / 回滚）
ECHOIC_IMAGE_TAG=latest
# GHCR 包首次发布后需设为 Public；未设 Public 时匿名拉取会 403，请先登录：
#   echo <你的GitHub PAT> | docker login ghcr.io -u <GitHub用户名> --password-stdin
#
# 源码构建（叠加 docker-compose.build.yml）时使用的本地镜像标签（避免覆盖官方 latest）
# ECHOIC_LOCAL_IMAGE=echoic:local

# ------------------------------- docker compose 专用 -------------------------------
# 宿主机映射端口（容器内固定 8000）
ECHOIC_HTTP_PORT=8000
# 构建期网络加速（仅源码构建 docker-compose.build.yml / docker build 使用）：
# NPM_REGISTRY=https://registry.npmmirror.com
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# PostgreSQL profile（--profile postgres）账号；生产环境务必修改密码
POSTGRES_USER=echoic
POSTGRES_PASSWORD=echoic
POSTGRES_DB=echoic
